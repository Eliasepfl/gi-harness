; Engine configuration file for the godotworld spike (rung-4 step 2).
;
; This is the STOCK-physics project (Godot Physics 2D). The rapier variant is a
; byte-identical copy of this file with one extra line
;   2d/physics_engine="Rapier2D"
; plus the godot-rapier2d GDExtension present under addons/ (see SPIKE_REPORT.md).
;
; Determinism discipline (mirrors nodeworld/world.js + notes/engines/GODOT_MIGRATION.md
; §2.4): fixed 60 Hz physics tick, jitter-fix off, physics on the main thread, a fresh
; deterministic world built per episode, ALL mutation inside the physics loop.

config_version=5

[application]

config/name="godotworld-spike"
config/features=PackedStringArray("4.7")
run/disable_stdout=false
; --fixed-fps 60 (a CLI flag, enforced Python-side) drives dt; cap the frame rate at
; unlimited so nothing throttles the fixed-step loop. Pinned to the engine default so
; a point-release flip cannot silently change stepping cadence (GODOT_DOCS_MINING.md §3).
run/max_fps=0

[threading]

; Cap the general-purpose WorkerThreadPool. Headless Godot otherwise sizes it to
; the HOST's online CPU count (448 on the ORCD nodes, ignoring our 4-core taskset),
; spawning ~450 threads PER process -- which blows the shared `ulimit -u` and lets
; only one Godot run at a time. Physics is on the main thread (2d/run_on_separate_
; thread=false), so this does not touch stepping/determinism; the batch runner stays
; byte-identical. A small pool is ample for our asset-free, headless workload.
worker_pool/max_threads=3

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.0
; Render-only interpolation, but pin it (to the current default) so a 4.7 point-release
; default flip cannot shift recorded transforms if rendering is ever added later.
common/physics_interpolation=false
2d/default_gravity=900.0
2d/default_gravity_vector=Vector2(0, -1)
2d/default_linear_damp=0.0
2d/default_angular_damp=0.0
2d/run_on_separate_thread=false
; Pin the contact-solver iteration count (to the current default, 16) so contact
; resolution cannot drift between engine releases and void byte-identical replay.
2d/solver/solver_iterations=16

[debug]

settings/stdout/verbose_stdout=false
; GDScript warnings are NOT determinism or sandbox controls (those are the banned-API
; scanner + the pinned physics); they are style/type hints. Godot 4.7 defaults the
; type-inference/Variant warning `inference_on_variant` to ERROR level, so a generated game
; with an untyped `var v := <Variant expr>` aborts at BOTH the standalone --check-only parse
; gate AND this serve host (Error 43) even though the code is valid GDScript that runs
; byte-identically (the value is simply typed Variant). Demote it (and clear the
; warnings-as-errors master) so a benign warning never sinks a G0 load. GENUINE parse/type
; errors (e.g. `Cannot infer the type ... doesn't have a set type`) have no warning level and
; stay fatal. 2026-07-17 parser-friction lever; verified in-image (Godot v4.7.stable).
gdscript/warnings/treat_warnings_as_errors=false
gdscript/warnings/inference_on_variant=0
